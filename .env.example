# --- Agent (Claude) — server only. Without it the agent runs in labelled local intent mode.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
SUBSCAN_AGENT_MODEL=

# --- Textile FX — server only. Optional: without a key, firm quotes use the wallet's
# EIP-712 TakerControl proof (signed in the browser on demand).
TEXTILE_API_KEY=
TEXTILE_API_BASE=

# --- Celo
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_APP_URL=

# --- ERC-8004 agent identity
ERC8004_AGENT_ID=
# Only for `npm run agent:register` (run locally, never deployed). Dedicated wallet.
AGENT_OWNER_PRIVATE_KEY=
AGENT_URI=

# --- Supabase (optional receipt mirroring) — server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mono (reserved; bank linking is not implemented yet)
NEXT_PUBLIC_MONO_PUBLIC_KEY=
