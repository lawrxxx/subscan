# ---------------------------------------------------------------------------
# subscan environment. Names only — never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ---------------------------------------------------------------------------

# Public URL of the deployment (used for auth/Mono redirects and the ERC-8004 card)
NEXT_PUBLIC_APP_URL=

# --- Supabase (accounts + database). Without these the app runs in guest mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for the Mono webhook (writes on the user's behalf).
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent (Claude). Without a key the agent runs in labelled local mode.
ANTHROPIC_API_KEY=
SUBSCAN_AGENT_MODEL=

# --- Mono bank linking (server only)
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=

# --- Textile FX (optional; without a key firm quotes use the wallet's TakerControl proof)
TEXTILE_API_KEY=
TEXTILE_API_BASE=

# --- Celo
NEXT_PUBLIC_CELO_RPC_URL=

# --- ERC-8004 agent identity
ERC8004_AGENT_ID=
# Only for `npm run agent:register`, run locally. Never set this on Vercel.
AGENT_OWNER_PRIVATE_KEY=
AGENT_URI=
