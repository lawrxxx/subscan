# ---------------------------------------------------------------------------
# subscan — Vercel environment variables. Names only; never commit values.
# NEXT_PUBLIC_* are exposed to the browser (and baked in at build time).
# Everything else stays server-side in Vercel functions.
# ---------------------------------------------------------------------------

# Public URL of the deployment (ERC-8004 agent card)
NEXT_PUBLIC_APP_URL=

# Overrides the built-in hackathon attribution code (celo_e97672462153).
# Added to every transaction's ERC-8021 tag alongside subscan's own code.
NEXT_PUBLIC_CELO_ATTRIBUTION_CODE=

# --- Textile FX (server only). Optional: without a key, firm quotes use the
# wallet's EIP-712 TakerControl proof. With a key, Textile also embeds the
# attribution codes in its swap transaction.
TEXTILE_API_KEY=
TEXTILE_API_BASE=

# --- Agent (Google Gemini, server only). Get a key at https://aistudio.google.com/apikey
# Without it the agent shows an "unavailable" state; it never fabricates answers.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
GEMINI_MODEL=

# --- Celo
NEXT_PUBLIC_CELO_RPC_URL=

# --- ERC-8004 agent identity
ERC8004_AGENT_ID=
# Only for `npm run agent:register`, run locally. Never set this on Vercel.
AGENT_OWNER_PRIVATE_KEY=
AGENT_URI=
